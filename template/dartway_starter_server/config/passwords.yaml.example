# The committed record of what each run mode needs — keys, not values.
#
# `dartway create` copies this file to passwords.yaml, which is git-ignored, so
# a new project runs locally without anyone filling anything in. The values
# below are throwaway and public; treat them as placeholders the moment the
# project stops being local.
#
# Secrets for a deployed environment never live here. They sit on the server,
# outside the checkout, where the `git reset --hard` a deploy performs cannot
# reach them: `dartway deploy secret push --env staging` sends them,
# `dartway deploy secret init` creates them in place.

development:
  database: 'dartway_dev_pw'
  serviceSecret: 'dev-service-secret-change-me'
  # Salts required by DartWay auth (see DwAuthConfig on the server).
  dwAuthKeySalt: 'dev-auth-key-salt-change-me'
  dwVerificationCodeSalt: 'dev-verification-code-salt-change-me'
  # Uploads: the `minio` service in docker-compose.yaml. The endpoint is what the
  # *browser and the device* will resolve, because the public file URLs are built
  # from it — which is why it is localhost here and a real host in production.
  dwCloudStorageRegion: 'us-east-1'
  dwCloudStorageEndpoint: 'localhost'
  dwCloudStoragePort: '8100'
  dwCloudStorageUseSSL: 'false'
  dwCloudStorageAccessKey: 'dartway_dev'
  dwCloudStorageSecretKey: 'dartway_dev_storage_pw'
  dwCloudStorageBucket: 'uploads'

# Matches the `postgres_test` service in docker-compose.yaml (localhost:9090).
test:
  database: 'dartway_test_pw'
  serviceSecret: 'test-service-secret'
  dwAuthKeySalt: 'test-auth-key-salt'
  dwVerificationCodeSalt: 'test-verification-code-salt'

# A deployed environment needs the same four keys, plus whatever the project
# added. Uncomment when you deploy — with the values left empty here, and the
# real ones pushed to the server.
#
# staging:
#   database:
#   serviceSecret:
#   dwAuthKeySalt:
#   dwVerificationCodeSalt:
#   redis:
