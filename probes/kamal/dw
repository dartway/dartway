#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root/.probe-private/probe_dw"
export FVM_CACHE_PATH="$root/.probe-private/fvm-ready"
exec fvm dart --packages="$root/.probe-private/cli/.dart_tool/package_config.json" \
  "$root/packages/dartway_cli/bin/dartway.dart" "$@"
